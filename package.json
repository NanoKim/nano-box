{
  "name": "nano-box",
  "version": "1.0.0",
  "description": "nano-box",
  "type": "module",
  "main": "./dist/nano-box.umd.cjs",
  "module": "./dist/nano-box.js",
  "types": "./dist/index.d.ts",
  "typings": "./dist/index.d.ts",
  "typesVersions": {
    "*": {
      "*": [
        "./dist/*"
      ]
    }
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/nano-box.js",
      "require": "./dist/nano-box.umd.cjs"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.umd.cjs"
    },
    "./nano-box.css": {
      "types": "./dist/index.d.ts",
      "default": "./dist/nano-box.css"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "dev": "vite --config playground/vite.config.ts",
    "build": "vite build"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NanoKim/nano-box.git"
  },
  "keywords": [
    "vue",
    "vue3",
    "components",
    "ui-library"
  ],
  "author": "",
  "license": "ISC",
  "peerDependencies": {
    "vue": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@typescript/typescript6": "^6.0.2",
    "@vitejs/plugin-vue": "^6.0.8",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vite-plugin-dts": "^5.0.3",
    "vite-plugin-lib-inject-css": "^2.2.2",
    "vue": "^3.5.41",
    "vue-tsc": "^3.3.10"
  }
}
